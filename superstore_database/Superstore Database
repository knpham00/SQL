-- ================================================
-- DATASET: Superstore Product Database
-- Analyzes product pricing, inventory, ratings, and 
-- category performance across a retail superstore
-- Written in PostgreSQL dialect
-- ================================================

CREATE TABLE superstore (
    item_id INTEGER PRIMARY KEY,
    item_name TEXT,
    category TEXT,
    price DECIMAL(10, 2),
    stock_quantity INTEGER,
    average_rating DECIMAL(3, 2)
);


-- ================================================
-- BASIC QUERIES
-- ================================================

-- ORDER BY: All items sorted by price low to high
-- Shows full product catalog in ascending price order

SELECT 
    item_name, 
    category, 
    price
FROM superstore
ORDER BY price ASC;


-- AVG: Average price across all products
-- Single aggregation to understand overall pricing

SELECT 
    ROUND(AVG(price), 2) AS avg_price
FROM superstore;


-- MAX + FILTER: Most expensive Kitchen Supplies item
-- Filters to one category then finds the highest price

SELECT 
    item_name, 
    MAX(price) AS max_price
FROM superstore
WHERE category = 'Kitchen Supplies'
GROUP BY item_name
ORDER BY max_price DESC
LIMIT 1;


-- ORDER BY: Items ranked from lowest to highest average rating
-- Shows which products customers rate least favorably

SELECT 
    item_name, 
    average_rating
FROM superstore
ORDER BY average_rating ASC;


-- ================================================
-- ADVANCED QUERIES
-- ================================================

-- CTE: Summarize performance metrics by category
-- Shows clean, readable logic using WITH statement

WITH category_summary AS (
    SELECT
        category,
        COUNT(*) AS total_items,
        ROUND(AVG(price), 2) AS avg_price,
        ROUND(AVG(average_rating), 2) AS avg_rating,
        SUM(stock_quantity) AS total_stock,
        ROUND(SUM(price * stock_quantity), 2) AS inventory_value
    FROM superstore
    GROUP BY category
)
SELECT *
FROM category_summary
ORDER BY inventory_value DESC;


-- WINDOW FUNCTION: Rank items by price within each category
-- Shows how each product is priced relative to its category peers

SELECT
    item_name,
    category,
    price,
    RANK() OVER (PARTITION BY category ORDER BY price DESC) AS price_rank
FROM superstore
ORDER BY category, price_rank;


-- WINDOW FUNCTION: Compare each item's rating to its category average
-- Identifies which products over or underperform vs category benchmark

SELECT
    item_name,
    category,
    average_rating,
    ROUND(AVG(average_rating) OVER (PARTITION BY category), 2) AS category_avg_rating,
    ROUND(average_rating - AVG(average_rating) OVER (PARTITION BY category), 2) AS diff_from_avg
FROM superstore
ORDER BY category, diff_from_avg DESC;


-- CASE STATEMENT: Categorize items by price tier and stock status
-- Segments inventory for purchasing and markdown decisions

SELECT
    item_name,
    category,
    price,
    stock_quantity,
    CASE
        WHEN price >= 200 THEN 'Premium'
        WHEN price >= 75 THEN 'Mid Range'
        ELSE 'Budget'
    END AS price_tier,
    CASE
        WHEN stock_quantity >= 75 THEN 'Overstocked'
        WHEN stock_quantity >= 40 THEN 'Healthy'
        WHEN stock_quantity >= 20 THEN 'Low'
        ELSE 'Critical'
    END AS stock_status
FROM superstore
ORDER BY price DESC;