-- ================================================

-- CTE: Rank products by total January revenue
-- Shows clean, readable logic using WITH statement

WITH jan_revenue AS (
    SELECT 
        product,
        SUM(quantity * price) AS total_revenue,
        SUM(quantity) AS total_units_sold
    FROM BIT_DB.JanSales
    WHERE length(orderid) = 6
    AND orderid <> 'Order ID'
    GROUP BY product
)
SELECT 
    product,
    total_revenue,
    total_units_sold,
    ROUND(total_revenue / total_units_sold, 2) AS avg_revenue_per_unit
FROM jan_revenue
ORDER BY total_revenue DESC;


-- WINDOW FUNCTION: Rank products by revenue within each month
-- Shows how products perform relative to each other

SELECT 
    product,
    SUM(quantity * price) AS total_revenue,
    RANK() OVER (ORDER BY SUM(quantity * price) DESC) AS revenue_rank
FROM BIT_DB.JanSales
WHERE length(orderid) = 6
AND orderid <> 'Order ID'
GROUP BY product;


-- CASE STATEMENT: Categorize orders by spend level
-- Segments customers into value tiers

SELECT 
    cust.acctnum,
    SUM(Feb.quantity * Feb.price) AS total_spent,
    CASE 
        WHEN SUM(Feb.quantity * Feb.price) > 1000 THEN 'High Value'
        WHEN SUM(Feb.quantity * Feb.price) BETWEEN 500 AND 1000 THEN 'Mid Value'
        ELSE 'Low Value'
    END AS customer_segment
FROM BIT_DB.FebSales Feb
LEFT JOIN BIT_DB.customers cust
    ON cust.order_id = Feb.orderID
WHERE length(orderid) = 6
AND orderid <> 'Order ID'
GROUP BY cust.acctnum
ORDER BY total_spent DESC;
