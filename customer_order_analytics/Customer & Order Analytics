-- ================================================
-- BASIC QUERIES
-- ================================================

-- COUNT: Total orders placed in January
-- Filters out dirty data rows using length check and header exclusion

SELECT 
    COUNT(orderid)
FROM BIT_DB.JanSales
WHERE length(orderid) = 6
AND orderid <> 'Order ID';

-- COUNT: January orders for a specific product (iPhone)
-- Adds product filter on top of data cleaning conditions

SELECT 
    COUNT(orderid)
FROM BIT_DB.JanSales
WHERE Product='iPhone'
AND length(orderid) = 6
AND orderid <> 'Order ID';

-- DISTINCT + JOIN: Customer account numbers for February orders
-- Uses INNER JOIN to match customers to their February purchases

SELECT 
    DISTINCT acctnum
FROM BIT_DB.customers cust
INNER JOIN BIT_DB.FebSales Feb
ON cust.order_id = Feb.OrderId
WHERE length(orderid) = 6
AND orderid <> 'Order ID';

-- ORDER BY + LIMIT: Cheapest product sold in January
-- Sorts ascending by price and returns only the top result

SELECT 
    DISTINCT product, 
    price
FROM BIT_DB.JanSales
ORDER BY price ASC LIMIT 1;

-- AGGREGATION: Total revenue per product in January
-- Multiplies quantity by price and groups by product

SELECT 
    SUM(quantity)*price as revenue, 
    product
FROM BIT_DB.JanSales
GROUP BY product;

-- FILTER + AGGREGATION: Sales at a specific location in February
-- Targets one address to analyze product mix and revenue

SELECT 
    product, 
    SUM(quantity)*price as revenue, 
    SUM(quantity)
FROM BIT_DB.FebSales
WHERE location = '548 Lincoln St, Seattle, WA 98101'
GROUP BY product;

-- AVG + COUNT + JOIN: High quantity February orders
-- Finds customers who ordered more than 2 items and their avg spend

SELECT 
    AVG(price*quantity), 
    COUNT(DISTINCT cust.acctnum)
FROM BIT_DB.FebSales Feb 
LEFT JOIN BIT_DB.customers cust
ON cust.order_id = Feb.orderID
WHERE Feb.quantity > 2
AND length(orderid) = 6
AND orderid <> 'Order ID';

-- LIKE + GROUP BY: Product sales in Los Angeles in February
-- Uses wildcard filter to find all LA locations

SELECT 
    Product, 
    SUM(Quantity)
FROM BIT_DB.FebSales
WHERE location like '%Los Angeles%'
GROUP BY Product;

-- HAVING: New York locations with 3 or more January orders
-- Uses HAVING to filter groups after aggregation

SELECT 
    DISTINCT location, 
    COUNT(orderID)
FROM BIT_DB.JanSales 
WHERE location LIKE '%NY%'
AND length(orderid) = 6
AND orderid <> 'Order ID'
GROUP BY location
HAVING count(orderID)>2;

SELECT *
FROM BIT_DB.FebSales
WHERE length(orderid) = 6
AND orderid <> 'Order ID';

-- LIKE + GROUP BY: Headphone sales breakdown in February
-- Filters all headphone variants using wildcard match

SELECT 
    SUM(Quantity) as quantity, 
    Product
FROM BIT_DB.FebSales
WHERE Product LIKE '%Headphones%'
GROUP BY Product;

-- AVG SPEND: Average amount spent per account in February
-- Divides total revenue by number of unique accounts

SELECT 
    SUM(quantity*price)/count(cust.acctnum)
FROM BIT_DB.FebSales Feb
LEFT JOIN BIT_DB.customers cust
ON cust.order_id = Feb.orderID
WHERE length(orderid) = 6 
AND orderid <> 'Order ID';

-- AVG QUANTITY: Average products purchased per account in February
-- Divides total units by number of unique customer accounts

SELECT 
SUM(Feb.quantity)/count(cust.acctnum)
FROM BIT_DB.FebSales Feb
LEFT JOIN BIT_DB.customers cust
ON cust.order_id = Feb.orderID
WHERE length(orderid) = 6 
AND orderid <> 'Order ID';

-- TOP PRODUCT: Highest revenue product in January
-- Orders by total revenue descending and returns only the top result

SELECT 
    product, 
    sum(quantity*price)
FROM BIT_DB.JanSales 
GROUP BY product
ORDER BY sum(quantity*price) desc 
LIMIT 1;

